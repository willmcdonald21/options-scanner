# Copy to .env and fill in. Never commit .env.
#
# Discord bot setup (see the README for the walkthrough):
#   1. Developer Portal -> New Application -> Bot
#   2. Enable the MESSAGE CONTENT INTENT (required to read pasted alerts)
#   3. Invite with: View Channels, Read Message History, Send Messages,
#      Add Reactions, Embed Links
#   4. Enable Developer Mode in Discord, then right-click to Copy ID
DISCORD_BOT_TOKEN=

# Input only. You paste advisor alerts here; the bot reads nothing else and
# posts no text here, only a status reaction on each alert.
ALERTS_CHANNEL_ID=

# Output. Every notification lands here, and your control commands
# (!status !halt !resume !flatten) are typed here. Must differ from above.
UPDATES_CHANNEL_ID=

# Your own Discord user ID. The bot ignores alerts and commands from anyone
# else, including itself.
OWNER_USER_ID=
