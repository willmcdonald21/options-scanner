# Discord bot (Developer Portal -> Bot -> enable Message Content intent,
# invite with View Channel + Read Message History on the target channel).
# CHANNEL_ID must be a channel in a server *you* own/admin -- alerts are
# manually copy-pasted there from the source channel (see bot/main.py and
# bot/text_import.py's docstring for why), so this bot never needs anyone
# else's approval to be added.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# IBKR Gateway/TWS API. Confirm the actual paper port in Gateway's own API
# settings dialog rather than assuming IBKR's documented default (4002) --
# this machine's ~/Jts/jts.ini currently has LocalServerPort=4000.
IBKR_HOST=127.0.0.1
IBKR_PORT=4000
IBKR_CLIENT_ID=11
MODE=paper

# Per-trade sizing cap in USD -- contracts = floor(cap / (entry_price * 100))
MAX_USD_PER_TRADE=1000

# Initial protective stop, in percent below the entry fill. Placed with the
# entry, then ratchets up: each trim target reached moves the stop to the
# previous rung (first target reached -> breakeven), so a position that has
# proven a level can never give it back.
STOP_LOSS_PCT=30

# STP (trigger -> market order, certain to exit) or STP_LMT (won't fill
# below its limit, so on a fast-moving option it may not exit at all).
STOP_ORDER_TYPE=STP
STOP_LIMIT_OFFSET_PCT=10

# At 1-2 contracts there's no room for a real ladder, so the last contract
# is held back as a runner: no resting limit, exited only by its stop. true
# keeps extending the ladder past the channel's last published target
# (125%, 150%, ...) so a runner's stop never stops climbing.
RUNNER_LADDER_EXTENDS=true

# IBKR market data: 1 live, 2 frozen, 3 delayed, 4 delayed-frozen. Runners
# need ticks to detect a target being reached. The bot downgrades to 3 and
# alerts if the account has no OPRA option-quote subscription.
IBKR_MARKET_DATA_TYPE=1

# Discord webhook for alerts (parse failures, order rejections, orphan
# trims, IBKR disconnects). Leave blank to log-only.
DISCORD_WEBHOOK_ALERTS=

# Discord webhook for trade activity -- one post per successful SELL fill
# (TRIM or SOLD ALL), i.e. every time the bot actually exits a position.
# Leave blank to skip (still logged either way).
DISCORD_WEBHOOK_TRADE_ACTIVITY=
